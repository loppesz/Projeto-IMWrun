{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["ES2022"],
    "paths": {
      "@imw/shared": ["../../packages/shared/src/index.ts"],
      "@imw/shared/*": ["../../packages/shared/src/*"],
      "@imw/api/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
